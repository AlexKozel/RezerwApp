# Копируйте в .env (файл .env в git не попадает). Секреты в репозиторий не коммитить.

# Роль мигратора: владелец схемы, применяет миграции. НЕ использовать в приложении.
MIGRATOR_DATABASE_URL=postgres://rezerwapp:rezerwapp@localhost:5432/rezerwapp

# Роль приложения: без SUPERUSER и BYPASSRLS, подчиняется Row-Level Security.
# Логин для роли задаётся один раз после первой миграции:
#   ALTER ROLE rezerwapp_app LOGIN PASSWORD '...';
DATABASE_URL=postgres://rezerwapp_app:rezerwapp_app@localhost:5432/rezerwapp

REDIS_URL=redis://localhost:6379

# Секрет для HMAC-хеша телефонов (поиск и blacklist без хранения номера в открытом виде).
PHONE_HASH_PEPPER=change-me

PORT=3000
