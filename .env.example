# Копируйте в .env (файл .env в git не попадает). Секреты в репозиторий не коммитить.

# Роль мигратора: владелец схемы, применяет миграции. НЕ использовать в приложении.
MIGRATOR_DATABASE_URL=postgres://rezerwapp:rezerwapp@localhost:5432/rezerwapp

# Роль приложения: без SUPERUSER и BYPASSRLS, подчиняется Row-Level Security.
# Логин для роли задаётся один раз после первой миграции:
#   ALTER ROLE rezerwapp_app LOGIN PASSWORD '...';
DATABASE_URL=postgres://rezerwapp_app:rezerwapp_app@localhost:5432/rezerwapp

REDIS_URL=redis://localhost:6380

# Секрет для HMAC-хеша телефонов (поиск и blacklist без хранения номера в открытом виде).
PHONE_HASH_PEPPER=change-me

# Мастер-ключ шифрования полей (D-042): 32 байта в base64. Значение ниже только для разработки,
# в production приложение с ним не запустится. Сгенерировать:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FIELD_MASTER_KEY=cmV6ZXJ3YXBwLWRldi1vbmx5LW1hc3Rlci1rZXktMzI=

# Тестовый OTP-код для клиентов в alpha (D-035), пока не подключён SMS-провайдер.
ALPHA_OTP_CODE=0000

# Адрес публичных страниц для ссылок в уведомлениях (D-052). В production обязателен и только https.
PUBLIC_URL=http://localhost:3001

# Чьему X-Forwarded-For верить при определении IP клиента (лимиты частоты, D-058). Локально с виджетом: loopback.
# В проде: число прокси перед API (обычно 1, nginx с $proxy_add_x_forwarded_for). Не задано: никому.
TRUST_PROXY=loopback

# Виджет записи (apps/widget): адрес API для серверного рендера и прокси /api.
# API_URL=http://localhost:3001

# Фоновые задачи BullMQ (D-049) в процессе API. false: API без задач, задачи отдельно через `pnpm --filter @rezerwapp/api worker`.
# WORKERS=true

# Cookie сессии только по HTTPS. По умолчанию true при NODE_ENV=production.
# COOKIE_SECURE=true

PORT=3000
