{
  "name": "rezerwapp",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "verify:db": "bash scripts/verify-db.sh",
    "db:migrate": "pnpm --filter @rezerwapp/api migrate",
    "create-master": "pnpm --filter @rezerwapp/api create-master",
    "legal:publish": "pnpm --filter @rezerwapp/api legal:publish",
    "admin": "pnpm --filter @rezerwapp/api admin",
    "dev:all": "node scripts/dev-all.mjs",
    "dev:lan": "node scripts/dev-all.mjs --lan",
    "demo:reset": "node scripts/dev-all.mjs --reset --no-run"
  },
  "devDependencies": {
    "typescript": "^5.9.0"
  }
}
